---
import { formatDate } from '../lib/dates';
import type { Video } from '../lib/youtube';

interface Props {
  video: Video;
  /** The unit's catalogue code, shown with the date. */
  code: string;
}

const { video, code } = Astro.props;
---

<a class="video" href={video.url}>
  <span class="thumb reg">
    <img src={video.thumbnail} alt="" width="480" height="360" loading="lazy" decoding="async" />
  </span>
  <span class="mono meta">{code} / <time datetime={video.published}>{formatDate(video.published)}</time></span>
  <h3>{video.title}</h3>
</a>

<style>
  .video {
    display: grid;
    gap: 12px;
    text-decoration: none;
    --reg: var(--line-strong);
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--carbon);
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transition: filter 240ms ease;
  }

  .meta {
    margin-top: 6px;
  }

  h3 {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  .video:hover {
    --reg: var(--accent);
  }

  .video:hover img {
    filter: none;
  }

  .video:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
</style>
