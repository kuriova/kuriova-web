---
import Mark from './Mark.astro';
import { getUnits, platformLinks } from '../lib/units';
import { site } from '../site';

const units = (await getUnits()).filter((u) => platformLinks(u).length > 0);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid" style={`--cols: ${units.length + 1}`}>
      <a class="brand" href="/" aria-label="Kuriova home">
        <Mark size={28} />
        <span class="wordmark">Kuriova</span>
      </a>
      {
        units.map((unit) => (
          <div class="col">
            <p class="label">
              {unit.status === 'live' ? <a href={`/${unit.slug}`}>{unit.name}</a> : unit.name}
            </p>
            <ul>
              {platformLinks(unit).map((link) => (
                <li>
                  <a href={link.url}>
                    {link.label}
                    <span class="sr-only"> ({unit.name})</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="col">
        <p class="label">Kuriova</p>
        <ul>
          <li><a href="/contact">Contact</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href="/links">All links</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
          <li><a href="/terms#affiliate-links">Affiliate disclosure</a></li>
        </ul>
      </div>
    </div>
    <div class="colophon">
      <p class="legal">© {year} Kuriova</p>
      <p class="mono">Set in Space Grotesk, Inter and Space Mono.</p>
    </div>
    <p class="giant" aria-hidden="true">Kuriova</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    margin-top: var(--section);
    padding-block: 64px 0;
    border-top: 1px solid var(--line-strong);
    font-size: 16px;
    background: linear-gradient(180deg, var(--carbon), var(--obsidian) 60%);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  /* The wordmark as an outline, cut off by the bottom edge of the page */
  .giant {
    margin: 32px 0 -0.22em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(64px, 19vw, 290px);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    white-space: nowrap;
    user-select: none;
  }

  .grid {
    display: grid;
    gap: 40px 32px;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1.5fr repeat(var(--cols), 1fr);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    align-self: start;
    gap: 12px;
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
  }

  .label {
    margin-bottom: 12px;
  }

  .label a {
    text-decoration: none;
  }

  .label a:hover {
    color: var(--polar);
  }

  .col li a {
    display: inline-block;
    padding-block: 6px;
    color: var(--mist);
    text-decoration: none;
  }

  .col li a:hover {
    color: var(--polar);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .legal {
    color: var(--mist);
    font-size: 14px;
  }
</style>
