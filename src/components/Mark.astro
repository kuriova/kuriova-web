03 -5 22 -23 29 -40 14z',
};

const MICRO = {
  viewBox: '0 0 2043.002253 2202.412727',
  transform: 'translate(-1022.000000,3149.377277) scale(0.100000,-0.100000)',
  d: 'M10291 31487 c-17 -4 -39 -19 -50 -33 l-21 -27 0 -10942 0 -10942 20 -26 c12 -15 38 -31 58 -37 52 -14 6122 -14 6174 0 20 6 46 23 58 37 l21 26 -1 2779 -1 2779 32 57 c81 143 107 204 117 280 26 185 25 214 -14 412 -37 193 -28 274 39 337 17 16 117 74 220 127 104 53 291 154 415 224 320 178 311 175 384 174 85 0 116 -15 265 -128 255 -195 285 -216 361 -251 42 -19 116 -43 164 -53 139 -30 118 -8 413 -435 126 -181 303 -436 394 -565 290 -413 379 -542 863 -1243 49 -70 157 -226 240 -345 83 -119 257 -370 386 -557 390 -564 588 -849 742 -1070 81 -115 236 -340 345 -500 339 -495 440 -626 660 -854 654 -676 1429 -1077 2355 -1218 107 -16 308 -17 2845 -20 1502 -2 2750 -1 2774 2 58 9 101 50 101 97 0 38 14 16 -680 1038 -222 327 -544 801 -715 1052 -407 600 -912 1341 -1156 1698 -107 157 -306 447 -441 645 -135 198 -292 428 -349 510 -56 83 -171 250 -253 372 -149 219 -255 375 -956 1398 -196 286 -434 635 -530 775 -95 140 -285 417 -420 615 -136 198 -383 560 -550 805 -167 245 -430 630 -585 855 -504 735 -666 974 -680 1010 -10 22 -15 70 -15 135 0 162 -60 314 -224 563 -174 264 -174 263 44 540 162 206 555 718 1187 1547 279 366 602 789 718 940 116 151 328 428 471 615 143 187 298 390 345 450 169 217 674 875 1285 1675 171 223 364 475 429 560 543 708 681 889 1014 1325 79 105 197 258 261 340 64 83 197 256 295 385 250 329 723 946 1015 1325 488 634 460 595 460 636 0 47 -30 85 -78 99 -49 13 -5183 14 -5367 0 -1092 -81 -2104 -561 -2819 -1335 -192 -208 -277 -320 -791 -1040 -39 -55 -130 -181 -202 -280 -71 -99 -219 -304 -328 -455 -109 -151 -237 -329 -285 -395 -48 -66 -169 -235 -270 -375 -101 -140 -258 -358 -350 -485 -192 -265 -372 -515 -625 -870 -98 -137 -291 -405 -429 -595 -137 -190 -305 -421 -373 -515 -777 -1072 -1100 -1475 -1657 -2063 -233 -246 -422 -427 -463 -443 -36 -14 -130 -14 -167 0 -16 7 -129 109 -252 227 -299 289 -302 297 -180 511 347 609 528 1259 565 2023 6 117 7 1362 4 3110 -4 2762 -6 2916 -22 2940 -10 14 -34 30 -54 37 -41 14 -6134 24 -6186 10z',
};

const mark = size <= 48 ? MICRO : STANDARD;
const [, , vbWidth = 1, vbHeight = 1] = mark.viewBox.split(' ').map(Number);
const width = Math.round((size * vbWidth) / vbHeight);
---

<svg
  class={className}
  viewBox={mark.viewBox}
  width={width}
  height={size}
  fill={color}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g transform={mark.transform}><path d={mark.d}></path></g>
</svg>
