03 -5 22 -23 29 -40 14z',
};

const MICRO = {
  viewBox: '0 0 2051.000000 2203.000000',
  transform: 'translate(-1022.000000,3150.000000) scale(0.100000,-0.100000)',
  d: 'M10220 20485 l0 -11015 3165 0 3165 0 0 3323 0 3322 163 82 c372 188 887 475 1244 694 l193 117 582 -841 c321 -463 583 -844 583 -848 0 -4 43 -67 95 -140 152 -216 300 -429 792 -1142 49 -70 157 -226 240 -345 83 -119 257 -370 386 -557 390 -564 588 -849 742 -1070 81 -115 236 -340 345 -500 339 -495 440 -626 660 -854 654 -676 1429 -1077 2355 -1218 107 -16 312 -17 2958 -20 1563 -2 2842 0 2842 5 0 10 -223 342 -760 1132 -222 327 -544 801 -715 1052 -407 600 -912 1341 -1156 1698 -107 157 -306 447 -441 645 -135 198 -292 428 -349 510 -56 83 -171 250 -253 372 -150 221 -273 401 -956 1398 -196 286 -439 642 -540 790 -101 149 -286 419 -410 600 -125 182 -400 584 -612 895 -212 311 -431 630 -486 710 -502 722 -1261 1843 -1255 1854 5 7 301 394 658 860 358 466 802 1046 988 1289 186 243 445 582 576 752 130 171 354 463 497 650 143 187 298 390 345 450 169 217 674 875 1285 1675 171 223 364 475 429 560 544 709 678 884 1012 1323 80 105 199 260 263 342 64 83 197 256 295 385 378 497 907 1185 1395 1818 195 252 186 240 179 247 -10 10 -5407 5 -5544 -5 -1092 -81 -2104 -561 -2819 -1335 -192 -208 -277 -320 -791 -1040 -39 -55 -130 -181 -202 -280 -71 -99 -219 -304 -328 -455 -109 -151 -237 -329 -285 -395 -48 -66 -169 -235 -270 -375 -101 -140 -258 -358 -350 -485 -192 -265 -372 -515 -625 -870 -98 -137 -291 -405 -429 -595 -137 -190 -305 -421 -373 -515 -526 -727 -751 -1021 -1075 -1411 -237 -286 -779 -876 -876 -953 -9 -8 -59 -55 -110 -105 l-93 -91 2 2680 c1 1474 1 3482 1 4463 l-2 1782 -3165 0 -3165 0 0 -11015z',
};

const mark = size <= 48 ? MICRO : STANDARD;
const [, , vbWidth = 1, vbHeight = 1] = mark.viewBox.split(' ').map(Number);
const width = Math.round((size * vbWidth) / vbHeight);
---

<svg
  class={className}
  viewBox={mark.viewBox}
  width={width}
  height={size}
  fill={color}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g transform={mark.transform}><path d={mark.d}></path></g>
</svg>
