---
/**
 * The K mark: stem, sweep and leg. The geometry never changes; only the colour does.
 * Paths are the brand pack v1.1.1 masters (mark/kuriova-mark-*.svg, also in public/brand/mark/).
 *
 * At 48 px or smaller the solid micro mark is used, because the cut lines
 * (3.5% of the height) vanish at that size.
 */
interface Props {
  /** Rendered height in px. */
  size: number;
  /** Any CSS colour. Defaults to the current text colour. */
  color?: string;
  /** Accessible name. Omit when the mark sits next to its own text. */
  label?: string;
  class?: string;
}

const { size, color = 'currentColor', label, class: className } = Astro.props;

