---
import VideoCard from './VideoCard.astro';
import { getLatestVideos } from '../lib/youtube';
import type { Unit } from '../lib/units';

interface Props {
  unit: Unit;
  heading: string;
  limit?: number;
}

const { unit, heading, limit = 3 } = Astro.props;
const videos = await getLatestVideos(unit.youtubeChannelId, limit);
const channel = unit.links.youtube;
---

<section class="section" aria-labelledby={`latest-${unit.slug}`} data-reveal style={`--accent: ${unit.accent}`}>
  <div class="container">
    <div class="section-head">
      <h2 id={`latest-${unit.slug}`}>{heading}</h2>
      {
        videos.length > 0 && channel && (
          <a class="text-link" href={`${channel}/videos`}>
            All videos <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
    {
      videos.length > 0 ? (
        <ul class="grid">
          {videos.map((video) => (
            <li>
              <VideoCard video={video} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty">
          <p class="label">In production</p>
          <p class="empty-title">First documentary coming soon</p>
          {channel && (
            <a class="text-link" href={`${channel}?sub_confirmation=1`}>
              Subscribe on YouTube to see it first <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 40px 24px;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 40px 28px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(var(--carbon) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--carbon) 1px, transparent 1px) 0 0 / 40px 40px;
  }

  .empty-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
</style>
