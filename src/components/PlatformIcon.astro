---
import type { PlatformKey } from '../lib/units';

interface Props {
  platform: PlatformKey;
  size?: number;
}

const { platform, size = 20 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    platform === 'youtube' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="4" />
        <path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor" />
      </>
    )
  }
  {
    platform === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    platform === 'tiktok' && (
      <path d="M14.5 3v11.2a3.8 3.8 0 1 1-3.8-3.8M14.5 3c.3 2.7 2.3 4.6 5 4.8" />
    )
  }
  {platform === 'facebook' && <path d="M15.5 3.5h-2A3.5 3.5 0 0 0 10 7v13.5M7 10.5h7.5" />}
  {
    platform === 'x' && (
      <>
        <path d="M4 4h4.6L20 20h-4.6z" />
        <path d="M19.6 4l-6.7 7.3M4.4 20l6.7-7.3" />
      </>
    )
  }
</svg>
