---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Lockup from '../components/Lockup.astro';
import LinkList from '../components/LinkList.astro';
import LatestVideos from '../components/LatestVideos.astro';
import Ruler from '../components/Ruler.astro';
import { getLiveUnits, subline, unitCode, unitTitle, type Unit } from '../lib/units';

export async function getStaticPaths() {
  const units = await getLiveUnits();
  return units.map((unit) => ({ params: { unit: unit.slug }, props: { unit } }));
}

interface Props {
  unit: Unit;
}

const { unit } = Astro.props;
// Each unit gets its own social image once public/brand/og-<slug>.png exists.
const image = existsSync(`public/brand/og-${unit.slug}.png`) ? `/brand/og-${unit.slug}.png` : undefined;
const youtube = unit.links.youtube;
---

<Base title={unitTitle(unit)} description={unit.tagline} image={image} accent={unit.accent}>
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="mono code">Catalogue {unitCode(unit)}</p>
      <Lockup as="h1" size={112} minSize={64} subline={subline(unit)} color="var(--accent)" />
      <p class="lede">{unit.tagline}</p>
      <dl class="spec reg" aria-label="Channel record">
        <div><dt class="mono">catalogue</dt><dd>{unitCode(unit)}</dd></div>
        <div><dt class="mono">status</dt><dd>Live</dd></div>
        <div><dt class="mono">pillars</dt><dd>{unit.pillars.length}</dd></div>
        {youtube && <div class="wide"><dt class="mono">channel</dt><dd>@{new URL(youtube).pathname.replace(/^\/@?/, '')}</dd></div>}
      </dl>
      {
        youtube && (
          <div class="actions">
            <a class="btn btn-accent" href={youtube}>
              Watch on YouTube
            </a>
            <a class="btn btn-outline" href={`${youtube}?sub_confirmation=1`}>
              Subscribe
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    unit.pillars.length > 0 && (
      <section class="section" aria-labelledby="pillars-title">
        <div class="container">
          <div class="section-head">
            <h2 id="pillars-title">What we cover</h2>
            <p class="mono">{unit.pillars.join(' / ')}</p>
          </div>
          <Ruler pillars={unit.pillars} caption={`${unit.name} pillars: ${unit.pillars.join(', ')}, across every scale from atoms to the observable universe.`} />
        </div>
      </section>
    )
  }

  <LatestVideos unit={unit} heading="Latest videos" limit={6} />

  <section class="section" aria-labelledby="follow-title">
    <div class="container follow">
      <div class="section-head">
        <h2 id="follow-title">Follow {unit.name}</h2>
      </div>
      <LinkList unit={unit} variant="buttons" />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 10vw, 136px) clamp(48px, 6vw, 88px);
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 32px;
    justify-items: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }


  .follow :global(.buttons) {
    max-width: 720px;
  }

  .spec {
    margin: 8px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 420px);
    border: 1px solid var(--line);
    background: rgb(15 23 42 / 0.6);
  }

  .spec div {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .spec .wide {
    grid-column: 1 / -1;
  }

  .spec dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  @media (min-width: 980px) {
    .hero-inner {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }

    .spec {
      grid-column: 2;
      grid-row: 1 / span 4;
      align-self: center;
      justify-self: end;
    }
  }
</style>
