---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Lockup from '../components/Lockup.astro';
import LinkList from '../components/LinkList.astro';
import LatestVideos from '../components/LatestVideos.astro';
import { getLiveUnits, subline, unitTitle, type Unit } from '../lib/units';

export async function getStaticPaths() {
  const units = await getLiveUnits();
  return units.map((unit) => ({ params: { unit: unit.slug }, props: { unit } }));
}

interface Props {
  unit: Unit;
}

const { unit } = Astro.props;
// Each unit gets its own social image once public/brand/og-<slug>.png exists.
const image = existsSync(`public/brand/og-${unit.slug}.png`) ? `/brand/og-${unit.slug}.png` : undefined;
const youtube = unit.links.youtube;
---

<Base title={unitTitle(unit)} description={unit.tagline} image={image} accent={unit.accent}>
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <Lockup as="h1" size={112} minSize={64} subline={subline(unit)} color="var(--accent)" />
      <p class="lede">{unit.tagline}</p>
      {
        youtube && (
          <div class="actions">
            <a class="btn btn-accent" href={youtube}>
              Watch on YouTube
            </a>
            <a class="btn btn-outline" href={`${youtube}?sub_confirmation=1`}>
              Subscribe
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    unit.pillars.length > 0 && (
      <section class="section" aria-labelledby="pillars-title" data-reveal>
        <div class="container">
          <div class="section-head">
            <h2 id="pillars-title">What we cover</h2>
          </div>
          <ul class="pillars">
            {unit.pillars.map((pillar, i) => (
              <li>
                <span class="label num">{String(i + 1).padStart(2, '0')}</span>
                <span class="pillar">{pillar}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <LatestVideos unit={unit} heading="Latest videos" limit={6} />

  <section class="section" aria-labelledby="follow-title" data-reveal>
    <div class="container follow">
      <div class="section-head">
        <h2 id="follow-title">Follow {unit.name}</h2>
      </div>
      <LinkList unit={unit} variant="buttons" />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 10vw, 136px) clamp(48px, 6vw, 88px);
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 32px;
    justify-items: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .pillars li {
    display: grid;
    gap: 24px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--carbon);
  }

  .num {
    color: var(--accent);
  }

  .pillar {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .follow :global(.buttons) {
    max-width: 720px;
  }
</style>
